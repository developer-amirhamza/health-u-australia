generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String              @id @default(dbgenerated("gen_random_uuid()"))
  email                  String              @unique
  password               String
  verify_email           Boolean?            @default(false)
  status                 String?             @default("ACTIVE")
  avatar                 String?
  mobile                 String?
  last_login_date        DateTime?           @db.Timestamp(6)
  refresh_token          String?
  forgot_password_otp    String?
  forgot_password_expire DateTime?           @db.Timestamp(6)
  createdAt              DateTime?           @default(now()) @db.Timestamp(6)
  updatedAt              DateTime?           @default(now()) @db.Timestamp(6)
  role                   String?             @default("USER")
  firstName              String?
  lastName               String?
  serviceAgreements      ServiceAgreement[]
}

// A participant's support-coordination NDIS plan: budget, billing rates and
// item codes for claims, and the plan's date window. `startDate`/`endDate`
// are plain "YYYY-MM-DD" calendar dates (not DateTime) because all budget
// pacing math in the admin UI works in whole calendar days with no time
// component or timezone — storing them as DateTime would just reintroduce
// timezone-shift bugs into date-only arithmetic that doesn't need one.
model ScPlan {
  id             String        @id @default(dbgenerated("gen_random_uuid()"))
  participant    String
  ndisNumber     String?
  coordinator    String
  rate           Float
  travelRate     Float         @default(0)
  itemCode       String
  travelItemCode String?
  budget         Float         @default(0)
  startDate      String
  endDate        String
  reportLeadDays Int           @default(42)
  color          String        @default("#2f6feb")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  entries        ScTimeEntry[]
}




// A single logged support-coordination time entry (support or travel),
// billed against its plan's rate/travelRate. Deleting a plan with entries
// is blocked in the controller rather than cascaded, so billing history
// is never silently lost.
model ScTimeEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  planId      String
  plan        ScPlan   @relation(fields: [planId], references: [id])
  date        String
  startTime   String
  endTime     String
  hours       Float
  // "support" | "travel"
  type        String
  activity    String
  note        String?
  coordinator String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([planId])
  @@index([date])
}

// A submitted NDIS Service Agreement & Consent Form from the Service
// Agreement Tool (client/src/app/components/ServiceAgreementForm.tsx).
// Field names mirror that form's FormValues 1:1 so the controller can pass
// req.body straight through. `items` is the Schedule of Supports line-item
// table — stored as JSON since it's only ever read/written as a whole
// array with the agreement, never queried by individual item.
model ServiceAgreement {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  // Lifecycle: DRAFT (saved, not yet signed) -> SIGNED (both signatures
  // present) -> ARCHIVED (superseded/cancelled). Set by the controller
  // based on whether both signatures are present, not chosen by the client.
  status String @default("DRAFT")

  // Staff member who prepared/submitted this agreement, if signed in.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  // 1. Parties
  participantName    String
  participantNdisNumber String
  participantRepName String
  agreementStartDate String
  agreementEndDate   String

  // 3 & 4. Schedule of supports / responsibilities
  supportsProvided String[] @default([])
  livesAlone       String   @default("")

  // 6. Pricing and payments
  managementType   String @default("")
  planManagerName  String @default("")
  planManagerEmail String @default("")

  // 11. Cancellation policy
  cancellationPolicyAcknowledged Boolean @default(false)

  // Consent for service delivery
  consentInfoConfidential Boolean @default(false)
  consentChangeAnytime    Boolean @default(false)
  consentMedication       String  @default("")
  consentMoneyManagement  String  @default("")
  consentPhotosService    String  @default("")
  consentPhotosMedia      String  @default("")
  consentPublishFeedback  String  @default("")

  // 12. Contact details
  contactAddress       String
  contactPhone         String
  contactEmail         String @default("")
  hasAlternativeContact String @default("")
  altRelationship      String[] @default([])
  altContactName       String   @default("")
  altContactNumber     String   @default("")
  altContactEmail      String   @default("")

  orgContactName    String @default("Health U Australia")
  orgPhone          String @default("")
  orgEmail          String @default("")
  orgPostalAddress  String @default("")

  // 13. Schedule of supports / quote
  quoteNumber    String  @default("")
  quoteDate      String  @default("")
  planStartDate  String  @default("")
  planEndDate    String  @default("")
  preparedBy     String  @default("")
  contactPerson  String  @default("")
  applyGst       Boolean @default(false)
  items          Json    @default("[]")

  // 14. Signatures
  agreementExplained      Boolean @default(false)
  participantSignature     String  @default("")
  participantSignatureName String  @default("")
  participantSignedDate    String  @default("")
  providerSignature         String  @default("")
  providerSignatureName     String  @default("")
  providerSignedDate        String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantName])
  @@index([status])
}
